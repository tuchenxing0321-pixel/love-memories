# CloudBase 环境 ID 不是密钥，可以出现在前端配置中。
CLOUDBASE_ENV_ID=memories-d4g4tuz0rd39f03f2
CLOUDBASE_REGION=ap-shanghai

# 正式接入时从 CloudBase 控制台创建。不要把 SecretId/SecretKey 放到网页里。
CLOUDBASE_PUBLISHABLE_KEY=

# 服务端 API Key 对应 service_role，只能注入云函数，严禁写入前端。
CLOUDBASE_APIKEY=
CLOUDBASE_APIKEY_ID=

# “你的镜头”云函数环境变量。两者同样不能写入网页源码。
# 更换 LENS_ACCESS_KEY 会立即使所有旧访客会话失效。
LENS_ACCESS_KEY=
LENS_SESSION_SECRET=
